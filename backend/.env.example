# Copy this file to .env and paste your Supabase session pooler connection
# string here. Percent-encode any special characters in the password
# (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

GOOGLE_CLIENT_ID=

# Used to sign login tokens. Set this to a long random string in production.
AUTH_SECRET=finance-dashboard-secret-change-this
